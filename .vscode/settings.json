{
  "git.enableCommitSigning": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "files.eol": "\n",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/vendor": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/vendor/**": true
  },
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}